# Quadlet unit for wormhole.page
#
# Runs the prebuilt GHCR image as a systemd service via Podman.
#
#   System-wide install:
#     sudo cp quadlet/wormhole-page.container /etc/containers/systemd/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now wormhole-page.service
#
#   Rootless (per-user) install:
#     mkdir -p ~/.config/containers/systemd
#     cp quadlet/wormhole-page.container ~/.config/containers/systemd/
#     systemctl --user daemon-reload
#     systemctl --user enable --now wormhole-page.service
#     (rootless also needs: loginctl enable-linger $USER)
#
# Logs:    journalctl -u wormhole-page.service -f
# Updates: the image publishes `latest` on every push to main.
#          AutoUpdate=registry + the podman auto-update timer picks it up:
#            sudo systemctl enable --now podman-auto-update.timer
#          (or: systemctl --user enable --now podman-auto-update.timer)
#
# Notes:
#   - WantedBy=default.target works for both system and user managers.
#   - Port 8080 is unprivileged, so rootless works unchanged.
#   - PublishPort is bound to localhost: run it behind a reverse proxy
#     (see deploy/README.md for a Caddy + Let's Encrypt setup). Open 80/443
#     to the proxy, not 8080.
#   - Infrastructure is configured via environment (see below); visitors can
#     also override relays per-browser via the in-app gear icon. A sane way
#     to point an OSS deployment at your own infrastructure:
#       Environment=TRANSIT_RELAY=transit.example.com:4001
#       Environment=WORMHOLE_MAILBOX_URL=wss://mailbox.example.com/v1
#       Environment=WORMHOLE_TRANSIT_HINT=tcp://transit.example.com:4001
#       Environment=WORMHOLE_PROFILE_NAME=example.com
#       Environment=CSP_CONNECT_SRC="'self' wss://mailbox.example.com"
#     Restart the unit; the client picks up /config.js on next load.

[Unit]
Description=wormhole.page — E2E encrypted file transfer in the browser
Documentation=https://github.com/dougsko/wormhole-page
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/dougsko/wormhole-page:latest
ContainerName=wormhole-page
PublishPort=127.0.0.1:8080:8080
# Transit relay for the WebSocket -> TCP bridge, dialed BY THE SERVER.
# Default: transit.magic-wormhole.io:4001 (upstream public relay).
Environment=TRANSIT_RELAY=transit.magic-wormhole.io:4001
# Deployment defaults advertised to the browser at /config.js. Empty values
# mean "fall back to the built-in defaults" (public Magic Wormhole mailbox,
# same-origin /transit bridge, public TCP peer hint).
#Environment=WORMHOLE_MAILBOX_URL=wss://mailbox.example.com/v1
#Environment=WORMHOLE_TRANSIT_URL=wss://transit.example.com/ws
#Environment=WORMHOLE_TRANSIT_HINT=tcp://transit.example.com:4001
#Environment=WORMHOLE_PROFILE_NAME=example.com
# Content-Security-Policy connect-src. Default: 'self' wss://relay.magic-wormhole.io:443
# (upstream-identical, tight). To let visitors use arbitrary relays from the
# settings gear: CSP_CONNECT_SRC="'self' ws: wss:"
#Environment=CSP_CONNECT_SRC="'self' ws: wss:"
# Hardening: the app reads only its static assets and makes outbound
# WebSocket/TCP connections; it never writes to the filesystem.
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
# Pull the newest image from GHCR when podman-auto-update.timer runs.
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
